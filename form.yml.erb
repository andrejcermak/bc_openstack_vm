<%
require "ood_core"
user = OodSupport::User.new

# configuration
openstack_instance = "brno.openstack.cloud.e-infra.cz"
token_file = "/tmp/#{user}-os-token.json"
cluster_name = "coder"
coder_template_version_id = "764b3d3d-1a8f-4257-a046-a11efffa8cb6"
coder_org_id = "e6cc4dfc-227d-48b0-b09e-6ec3eec7d490"


helper = OodCore::OpenStackHelper.new(token_file: token_file, openstack_instance: openstack_instance)
projects, flavors = helper.load_projects_and_flavors
%>

---
cluster:
  - <%= cluster_name %>
workspace_name: "workspace"
form:
  - project_id
  - flavor
  - ssh_public_key
attributes:
  project_id:
    widget: "select"
    label: "OpenStack project"
    required: true
    help: |
      Select your OpenStack project. If the dropdown is empty and you already have a project in OpenStack, login to <a href="https://horizon.<%= openstack_instance %>/">Horizon</a> and then refresh this page. If that does not help, there might be an issue with OpenStack. In that case, please contact <a href="mailto:cloud@metacentrum.cz">support</a>.
    options:
      <%- projects.each do |project| %>
      - ["<%= project['name'] %>", "<%= project['id'] %>"]
      <%- end %>

  flavor:
    widget: "select"
    label: "Node flavor"
    required: true
    help: |
      Select the VM flavor (compute resources) for your instance. Available options depend on your selected project.
    options:
      <%- flavors.each do |flavor| %>
      - ["<%= flavor[0] %>", "<%= flavor[1] %>", data-exclusive-option-for-project-id-<%= flavor[2] %>: true]
      <%- end %>

  ssh_public_key:
    widget: "text_area"
    label: "SSH public key"
    required: true
    help: |
      Paste your SSH public key (typically from ~/.ssh/id_rsa.pub or ~/.ssh/id_ed25519.pub).
      The key will be deployed to authorize SSH access to your VM.
      Multiple keys can be provided, one per line.
